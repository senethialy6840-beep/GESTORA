generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// MULTI-TENANT FOUNDATION
// -----------------------------------------------------------------------------

model Company {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  logoUrl     String?
  taxNumber   String?
  address     String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  users       User[]
  warehouses  Warehouse[]
  products    Product[]
  customers   Customer[]
  sales       Sale[]
  purchases   Purchase[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String?
  firstName   String
  lastName    String
  avatarUrl   String?
  role        String   @default("USER") // SUPER_ADMIN, ADMIN, MANAGER, CASHIER, STOCK_KEEPER, USER
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// INVENTORY & WAREHOUSE MANAGEMENT
// -----------------------------------------------------------------------------

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  location    String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String?
  barcode     String?
  description String?
  price       Float
  cost        Float
  stock       Int      @default(0)
  stockAlert  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// CRM & SALES
// -----------------------------------------------------------------------------

model Customer {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  mensualite  Float    @default(0)
  balance     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales       Sale[]
}

model Sale {
  id          String   @id @default(uuid())
  invoiceNo   String
  totalAmount Float
  status      String   @default("COMPLETED") // DRAFT, PENDING, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  
  items       SaleItem[]
}

model SaleItem {
  id          String   @id @default(uuid())
  description String
  quantity    Int
  price       Float
  
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// PURCHASES & SUPPLIERS
// -----------------------------------------------------------------------------

model Purchase {
  id          String   @id @default(uuid())
  orderNo     String
  totalAmount Float
  status      String   @default("PENDING") // DRAFT, PENDING, RECEIVED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
