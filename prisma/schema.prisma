generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// -----------------------------------------------------------------------------
// MULTI-TENANT FOUNDATION
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  logoUrl   String?
  taxNumber String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  plan      String   @default("STARTUP") // STARTUP, BUSINESS, ENTREPRISE
  subscriptionStatus String @default("PENDING") // ACTIVE, PENDING, EXPIRED, CANCELLED
  subscriptionExpiresAt DateTime?

  // Settings Régionaux et Facturation
  currency       String?  @default("XOF")
  timezone       String?  @default("GMT")
  dateFormat     String?  @default("DD/MM/YYYY")
  invoicePrefix  String?  @default("FAC-")
  invoiceFooter  String?

  users        User[]
  warehouses   Warehouse[]
  products     Product[]
  customers    Customer[]
  sales        Sale[]
  purchases    Purchase[]
  suppliers    Supplier[]
  employees    Employee[]
  transactions AccountingTransaction[]
  stockMovements StockMovement[]
  referrals      Referral[] @relation("ReferredCompany")
  subscriptionPayments SubscriptionPayment[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  firstName String
  lastName  String
  avatarUrl String?
  role      String   @default("USER") // SUPER_ADMIN, ADMIN, MANAGER, CASHIER, STOCK_KEEPER, USER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commercial Commercial?
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}


// -----------------------------------------------------------------------------
// INVENTORY & WAREHOUSE MANAGEMENT
// -----------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Paramètres de la boutique (indépendants de la compagnie)
  logoUrl        String?
  taxNumber      String?
  address        String?
  phone          String?
  email          String?
  currency       String?
  timezone       String?
  dateFormat     String?
  invoicePrefix  String?
  invoiceFooter  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products     Product[]
  customers    Customer[]
  sales        Sale[]
  purchases    Purchase[]
  employees    Employee[]
  transactions AccountingTransaction[]
  stockMovements StockMovement[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String?
  barcode     String?
  description String?
  price       Float
  cost        Float
  stock       Int      @default(0)
  stockAlert  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  stockMovements StockMovement[]
}

model StockMovement {
  id          String   @id @default(uuid())
  type        String   // IN, OUT
  quantity    Int
  reason      String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// CRM & SALES
// -----------------------------------------------------------------------------

model Customer {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  address    String?
  mensualite Float    @default(0)
  balance    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  sales     Sale[]
}

model Sale {
  id          String   @id @default(uuid())
  invoiceNo   String
  totalAmount Float
  status      String   @default("COMPLETED") // DRAFT, PENDING, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items SaleItem[]
}

model SaleItem {
  id          String @id @default(uuid())
  description String
  quantity    Int
  price       Float

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// PURCHASES & SUPPLIERS
// -----------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(uuid())
  orderNo     String
  totalAmount Float
  status      String   @default("PENDING") // DRAFT, PENDING, RECEIVED, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  items PurchaseItem[]
}

model PurchaseItem {
  id          String @id @default(uuid())
  description String
  quantity    Int
  price       Float

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// HUMAN RESOURCES (HR)
// -----------------------------------------------------------------------------

model Employee {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  role       String
  department String?
  joinDate   DateTime?
  salary     Float     @default(0)
  status     String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// ACCOUNTING
// -----------------------------------------------------------------------------

model AccountingTransaction {
  id          String   @id @default(uuid())
  date        DateTime
  description String
  type        String // INCOME, EXPENSE
  category    String
  amount      Float
  status      String   @default("COMPLETED") // COMPLETED, PENDING, CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// AFFILIATION COMMERCIALE & COMMISSIONS
// -----------------------------------------------------------------------------
// A platform customer is represented by Company: one Company is created when an
// account registers.  This deliberately does not reuse Customer, which is the
// CRM customer belonging to an individual Company's own store.

model Commercial {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  nom             String
  prenom          String
  email           String   @unique
  telephone       String?
  codeAffiliation String   @unique @map("code_affiliation")
  lienAffiliation String   @map("lien_affiliation")
  tauxCommission  Float    @default(20) @map("taux_commission")
  statut          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Referral[]
  commissions Commission[]
  payouts     CommissionPayout[]

  @@map("commercials")
}

model Referral {
  id              String   @id @default(uuid())
  commercialId    String   @map("commercial_id")
  customerId      String   @unique @map("customer_id")
  codeAffiliation String   @map("code_affiliation")
  dateAttribution DateTime @default(now()) @map("date_attribution")
  source          String   @default("register")
  statut          String   @default("PENDING")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  commercial Commercial @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  customer   Company    @relation("ReferredCompany", fields: [customerId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([commercialId])
  @@map("referrals")
}

model SubscriptionPayment {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  provider          String   @default("SASPAY")
  providerPaymentId String?  @unique @map("provider_payment_id")
  reference         String   @unique
  plan              String
  billingCycle      String   @default("monthly") @map("billing_cycle")
  amount            Int
  currency          String   @default("XOF")
  statut            String   @default("CONFIRMED")
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commission Commission?

  @@index([companyId])
  @@map("subscription_payments")
}

model Commission {
  id                    String   @id @default(uuid())
  commercialId          String   @map("commercial_id")
  referralId            String   @map("referral_id")
  subscriptionPaymentId String   @unique @map("subscription_payment_id")
  montantPaye           Int      @map("montant_paye")
  tauxCommission        Float    @map("taux_commission")
  montantCommission     Int      @map("montant_commission")
  plan                  String
  statut                String   @default("PENDING")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  payoutId              String?  @map("payout_id")

  commercial          Commercial          @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  referral            Referral            @relation(fields: [referralId], references: [id], onDelete: Cascade)
  subscriptionPayment SubscriptionPayment @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Cascade)
  payout              CommissionPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([commercialId, statut])
  @@index([referralId])
  @@map("commissions")
}

model CommissionPayout {
  id         String   @id @default(uuid())
  commercialId String @map("commercial_id")
  montant    Int
  methode    String
  reference  String?
  paidAt     DateTime @default(now()) @map("paid_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  commercial Commercial   @relation(fields: [commercialId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([commercialId])
  @@map("commission_payouts")
}
